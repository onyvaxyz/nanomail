{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte für Haupt- und Verfassen-Fenster: Core-APIs (Events), Datei-Dialog, weitere Fenster öffnen.",
  "windows": ["main", "verfassen-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "dialog:allow-open"
  ]
}
