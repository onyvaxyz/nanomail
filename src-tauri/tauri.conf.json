{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nanomail",
  "version": "0.1.0",
  "identifier": "io.github.onyvaxyz.nanomail",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nanomail",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Productivity",
    "shortDescription": "Mail- & Kalender-Client",
    "longDescription": "Eigener Mail- (IMAP/SMTP) und Kalender-Client (CalDAV) für Ubuntu.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
